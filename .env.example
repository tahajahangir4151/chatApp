# =======================
# Backend Configuration
# =======================

# Port for the Node.js Express server (default: 8080 or 5000)
PORT=8080

# MongoDB Connection String
# Replace with your actual MongoDB URI (e.g., mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGO_URI=mongodb+srv://username:password@cluster0.jqmclhw.mongodb.net/?appName=Cluster0

# JWT Secret Key for token generation
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (used in email verification & chat invite links)
CLIENT_URL=http://localhost:3000

# =======================
# Email SMTP App Configuration (Nodemailer)
# =======================
# Recommended: Gmail SMTP with App Password
# Steps to obtain your Google App Password:
# 1. Open Google Account Security: https://myaccount.google.com/security
# 2. Under "How you sign in to Google", enable "2-Step Verification" (if not already enabled)
# 3. Open App Passwords: https://myaccount.google.com/apppasswords
# 4. Enter an App Name (e.g., "Talk-A-Tive" or "ChatApp") and click "Create"
# 5. Copy the generated 16-character code (spaces are automatically handled)
# 6. Paste the credentials below:

EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Talk-A-Tive" <your_email@gmail.com>

# ----------------------------------------------------
# Alternative: Custom / Other SMTP Service (Optional)
# (Uncomment below if using Mailtrap, Brevo, SendGrid, Outlook, Yahoo, or custom SMTP server)
# ----------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password

# =======================
# Frontend Configuration
# =======================

# Backend API URL (used for HTTP requests from React)
REACT_APP_API_URL=http://localhost:8080
